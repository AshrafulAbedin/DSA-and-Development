  "Competitive Programming GOD-LEVEL Template": {
    "prefix": "cb",
    "body": [
      "#include <bits/stdc++.h>",
      "using namespace std;",
      "",
      "#define fo(i, n) for (int i = 0; i < (n); ++i)",
      "#define Fo(i, k, n) for (int i = (k); (k) < (n) ? i < (n) : i > (n); (k) < (n) ? ++i : --i)",
      "#define lld long long",
      "#define debug(x) cerr << \"[\" << __LINE__ << \"] \" << #x << \" = \" << x << endl",
      "#define debv(v) cerr << #v << \" = \"; for(auto &i:v) cerr << i << \" \"; cerr << endl;",
      "#define all(x) (x).begin(), (x).end()",
      "#define clr(x) memset(x, 0, sizeof(x))",
      "#define sortall(x) sort(all(x))",
      "#define PI 3.1415926535897932384626",
      "",
      "typedef vector<int> vi;",
      "typedef pair<int,int> pi;",
      "typedef vector<pi> vpi;",
      "typedef vector<vi> vvi;",
      "typedef vector<lld> vll;",
      "typedef unordered_map <lld,lld> mpp;",
      "",
      "const lld MOD = 1'000'000'007;",
      "",
      "// =========================",
      "// PREBUILT FUNCTIONS",
      "// =========================",
      "lld gcd(lld a, lld b){ return b==0?a:gcd(b,a%b); }",
      "lld lcm(lld a,lld b){ return a*b/gcd(a,b); }",
      "lld mod_add(lld a,lld b,lld m=MOD){return (a+b)%m;}",
      "lld mod_sub(lld a,lld b,lld m=MOD){return (a-b+m)%m;}",
      "lld mod_mul(lld a,lld b,lld m=MOD){return (a*b)%m;}",
      "lld binexp(lld a, lld b, lld m=MOD){",
      "    lld res=1; a%=m;",
      "    while(b>0){",
      "        if(b&1) res=mod_mul(res,a,m);",
      "        a=mod_mul(a,a,m);",
      "        b>>=1;",
      "    }",
      "    return res;",
      "}",
      "bool isPrime(lld n){",
      "    if(n<=1) return false;",
      "    if(n<=3) return true;",
      "    if(n%2==0||n%3==0) return false;",
      "    for(lld i=5;i*i<=n;i+=6) if(n%i==0||n%(i+2)==0) return false;",
      "    return true;",
      "}",
      "vector<bool> sieve(lld n){",
      "    vector<bool> prime(n+1,true);",
      "    prime[0]=prime[1]=false;",
      "    for(lld i=2;i*i<=n;i++){",
      "        if(prime[i]){",
      "            for(lld j=i*i;j<=n;j+=i) prime[j]=false;",
      "        }",
      "    }",
      "    return prime;",
      "}",
      "",
      "// =========================",
      "// DSU (Disjoint Set Union)",
      "// =========================",
      "struct DSU{",
      "    vector<lld> parent, rank;",
      "    DSU(lld n){ parent.resize(n); rank.resize(n,1); iota(all(parent),0); }",
      "    lld find(lld x){ return x==parent[x]?x:parent[x]=find(parent[x]); }",
      "    void unite(lld x,lld y){",
      "        x=find(x); y=find(y);",
      "        if(x==y) return;",
      "        if(rank[x]<rank[y]) swap(x,y);",
      "        parent[y]=x;",
      "        if(rank[x]==rank[y]) rank[x]++;",
      "    }",
      "};",
      "",
      "// =========================",
      "// BFS / DFS helpers",
      "// =========================",
      "void BFS(lld s, vector<vector<lld>> &adj){",
      "    lld n=adj.size();",
      "    vector<bool> vis(n,false);",
      "    queue<lld> q; q.push(s); vis[s]=true;",
      "    while(!q.empty()){",
      "        lld u=q.front(); q.pop();",
      "        for(lld v: adj[u]) if(!vis[v]){ q.push(v); vis[v]=true; }",
      "    }",
      "}",
      "void DFS(lld u, vector<vector<lld>> &adj, vector<bool> &vis){",
      "    vis[u]=true;",
      "    for(lld v: adj[u]) if(!vis[v]) DFS(v,adj,vis);",
      "}",
      "",
