      "    cin.tie(NULL);",
      "",
      "    Solution sol;",
      "",
      "    lld t=1;",
      "    // cin >> t; // uncomment if multiple test cases",
      "    while(t--){",
      "        sol.solve();",
      "    }",
      "    return 0;",
      "}"
    ],
